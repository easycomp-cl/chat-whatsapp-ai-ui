# Local: copiar a .env.local
# Vercel Preview (staging): Project Settings → Environment Variables → Preview
# Vercel Production: Project Settings → Environment Variables → Production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Producción: https://chatbotmanager.easycomp.cl
# Local: http://localhost:3000 | AWS: https://api-chatbotmanager.easycomp.cl
BOT_API_BASE_URL=https://api-chatbotmanager.easycomp.cl
NEXT_PUBLIC_BOT_API_BASE_URL=https://api-chatbotmanager.easycomp.cl
# Debe coincidir con INTERNAL_API_KEY del backend (AWS Secrets Manager / .env del bot)
BOT_API_SECRET=

# Meta Embedded Signup (Facebook Login for Business)
NEXT_PUBLIC_META_APP_ID=1642810900259407
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=1919146745399628
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0

# Solo local: Deploy Hooks de Vercel (Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=
VERCEL_DEPLOY_HOOK_URL_STAGING=

